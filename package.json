{
  "name": "lab40",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicação-base para avaliação prática de CI/CD",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "eslint src/features/feature28.js \"test/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check src/features/feature28.js \"test/**/*.js\" \"scripts/**/*.js\" package.json README.md eslint.config.js \".github/workflows/*.yml\"",
    "test:smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^10.16.0",
    "prettier": "^3.10.1"
  }
}
